---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocsSearch from '@/components/DocsSearch.astro';
import { apiGroups, operationsFor } from '@/lib/api';

type Props = { title: string; description: string; currentGroup?: string };
const { title, description, currentGroup = '' } = Astro.props;
---

<BaseLayout title={title} description={description} theme="docs">
  <div class="docs-shell docs-shell-wide api-shell">
    <nav class="docs-sidebar" aria-label="API reference" data-docs-sidebar data-collapsed>
      <button class="docs-sidebar-toggle" type="button" aria-expanded="false" data-docs-sidebar-toggle>
        <span>Browse the API</span>
        <svg class="toggle-open" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
    <svg class="toggle-close" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg>
      </button>
      <label class="docs-sidebar-filter">
        <span class="sr-only">Filter the API menu</span>
        <input type="search" placeholder="Filter this menu" data-sidebar-search />
      </label>
      <details class="docs-nav-group" open>
        <summary>API reference</summary>
        <div>
          <a href="/developers/api/" aria-current={!currentGroup ? 'page' : undefined}>Overview and core API</a>
          <a href="/docs/developers/api-overview/">API architecture overview</a>
          <a href="/docs/developers/authentication/">Authentication</a>
        </div>
      </details>
      {apiGroups.map((group) => {
        const active = group.id === currentGroup;
        return (
          <details class="docs-nav-group" open={active}>
            <summary>{group.title}</summary>
            <div>
              {operationsFor(group.id).map((operation) => (
                <a class="api-nav-op" href={`/developers/api/${group.id}/#${operation.operationId}`}>
                  <span class={`api-nav-method api-nav-${operation.method}`}>{operation.method === 'delete' ? 'DEL' : operation.method.toUpperCase()}</span>
                  <span>{operation.title}</span>
                </a>
              ))}
            </div>
          </details>
        );
      })}
    </nav>
    <div class="docs-main api-main">
      <slot />
    </div>
  </div>
  <DocsSearch />
  <script is:inline defer src="/scripts/docs-sidebar.js"></script>
  <script is:inline defer src="/scripts/api-reference.js"></script>
</BaseLayout>
