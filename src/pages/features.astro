---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TvFrame from '@/components/TvFrame.astro';
import BrowserFrame from '@/components/BrowserFrame.astro';

const features = [
  {
    title: 'Libraries for everything you keep',
    body: 'Separate libraries for movies, TV, anime, music, audiobooks, live channels and recordings. Portico adds artwork and details without touching the files.'
  },
  {
    title: 'An account for everyone',
    body: 'Each person has their own progress, Saved items, history, preferences and access. The server owner decides which libraries and actions each account can use.'
  },
  {
    title: 'Playback that fits the device',
    body: 'Portico plays the original file whenever it can. When a device, audio track, subtitle or connection needs a different format, the server converts it.'
  },
  {
    title: 'Live TV and DVR',
    body: 'Bring in compatible channels and guide data, watch live, schedule recordings and resolve conflicts, all on the same server.'
  },
  {
    title: 'Direct remote connections',
    body: 'A Portico Account helps your apps find and verify your server. Media then goes straight to that server, never through Portico Cloud.'
  },
  {
    title: 'Server management built in',
    body: 'Libraries, people, playback, remote access, Live TV, scheduled work, backups, diagnostics and server health, all managed from Portico.'
  }
];
---

<BaseLayout title="Features" description="Libraries, playback, personal accounts, remote access, Live TV and DVR, and server management in Portico.">
  <header class="page-hero">
    <div class="container">
      <span class="eyebrow">Features</span>
      <h1 class="display-1">Made for the people<br />who watch, and the one<br />who runs the server.</h1>
      <p class="lede">Viewers get a clean library and a player that just works. Server owners get the controls they need, without cluttering everyone else's screen.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/download/">Get Portico <span aria-hidden="true">↗</span></a>
        <a class="button button-ghost" href="/docs/">Read the docs</a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container feature-rows">
      <div class="feature-row">
        <div class="feature-copy">
          <h2 class="display-3">From your library to the player, it feels the same everywhere.</h2>
          <p class="lede">Browse, search, save and resume with the same account wherever you use Portico. Start on the TV and finish on your phone.</p>
          <ul class="check-list">
            <li>Continue Watching follows you between screens</li>
            <li>Saved items, history and ratings stay with your account</li>
            <li>Every app shares the same server, so nothing needs syncing</li>
          </ul>
        </div>
        <TvFrame src="/media/portico-home.png" alt="Portico's Home screen with Continue Watching" glow="blue" />
      </div>
      <div class="feature-row">
        <div class="feature-copy">
          <h2 class="display-3">Your collection, with the details filled in.</h2>
          <p class="lede">Posters, backdrops, cast, seasons and episodes come in automatically when Portico scans your folders. If a title is matched wrong, you can fix it in a few clicks.</p>
          <a class="text-link" href="/docs/media/fix-a-match/">How to fix a match <span aria-hidden="true">→</span></a>
        </div>
        <BrowserFrame src="/media/portico-detail.png" alt="Portico's show page for Fargo" address="web.getportico.tv" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="display-2">Everything in<br />one server.</h2>
      <div class="feature-grid">
        {features.map((feature, index) => (
          <article>
            <span class="feature-index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="features-cta">
    <div class="final-ambient" aria-hidden="true"></div>
    <div class="container">
      <h2 id="features-cta" class="display-1">Bring your library home.</h2>
      <div class="hero-actions">
        <a class="button button-primary" href="/download/">Get Portico <span aria-hidden="true">↗</span></a>
        <a class="button button-ghost" href="/docs/start/quick-start/">Read the quick start</a>
      </div>
    </div>
  </section>
</BaseLayout>
