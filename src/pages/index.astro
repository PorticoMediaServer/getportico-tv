---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TvFrame from '@/components/TvFrame.astro';
import BrowserFrame from '@/components/BrowserFrame.astro';
import PlatformIcon from '@/components/PlatformIcon.astro';
import { serverPlatforms, watchPlatforms } from '@/data/platforms';

const allLibraries = ['Movies', 'TV Shows', 'Anime', 'Music', 'Audiobooks'];
const people = [
  { name: 'Sam', role: 'Server owner', hue: 205, watching: [{ title: 'Fargo · S2 E3', progress: 64 }, { title: 'The Florida Project', progress: 22 }], libraries: allLibraries },
  { name: 'Riley', role: 'Member', hue: 32, watching: [{ title: 'Project Hail Mary · Ch. 14', progress: 48 }, { title: 'Spirited Away', progress: 81 }], libraries: ['Movies', 'Anime', 'Audiobooks'] },
  { name: 'Jordan', role: 'Member', hue: 160, watching: [{ title: 'The Rookie · S6 E1', progress: 35 }, { title: 'Rumours · Fleetwood Mac', progress: 57 }], libraries: ['Movies', 'TV Shows', 'Music'] }
];

const faqs = [
  {
    q: 'What do I need to run Portico?',
    a: 'A Windows, macOS or Linux computer (or anything that runs Docker) that can reach your media files and stays on while people are watching. Add a reliable home network and a Portico app or a web browser on each screen.'
  },
  {
    q: 'Is Portico free?',
    a: 'Yes. Portico Server is free to download and use, and its source code is published under the GPL-3.0 licence.'
  },
  {
    q: 'Do I need a Portico Account?',
    a: 'No. You can create a server owner that exists only on your server. A Portico Account is optional. It gives you one sign-in across Portico apps, simple invitations, and a secure connection to your server that Portico sets up for you.'
  },
  {
    q: 'Does my media pass through Portico?',
    a: 'No. Video, music, artwork and your watch activity go straight from your server to your screen. Portico Cloud helps apps find and verify your server, and that is all it sees.'
  },
  {
    q: 'Where can I watch?',
    a: 'In any modern web browser, and in the Portico apps for iPhone, iPad, Android, Apple TV, Android TV and Google TV, Fire TV, Roku, LG, Samsung and Xbox.'
  },
  {
    q: 'Can everyone at home use it?',
    a: 'Yes. Give each person their own account. They get their own progress, Saved items, history and ratings, and you choose which libraries they can see.'
  }
];
---

<BaseLayout title="Portico" description="Portico is a free media server. Keep your movies, shows, music, audiobooks and live TV on your own computer and watch them on every screen in the house.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-ambient" aria-hidden="true"></div>
    <div class="container hero-grid">
      <h1 id="hero-title" class="hero-title">Your own <span class="accent-text">streaming service.</span></h1>
      <div class="hero-side">
        <p>Portico turns the movies, shows, music and audiobooks on your computer into something the whole house can stream, on the TV, phone, tablet and browser. No subscription, no ads, and nothing uploaded to anyone else's cloud.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/download/">Get Portico <span aria-hidden="true">↗</span></a>
          <a class="button button-ghost" href="/features/">See features</a>
        </div>
      </div>
    </div>
    <div class="container hero-stage">
      <TvFrame src="/media/portico-home.png" alt="Portico's Home screen with Fargo featured in Continue Watching" />
    </div>
  </section>

  <section class="section section-split" aria-labelledby="library-title">
    <div class="section-ambient ambient-violet" aria-hidden="true"></div>
    <div class="container split">
      <div class="split-copy">
        <h2 id="library-title" class="display-2">Your files,<br />looking their best.</h2>
        <p class="lede">Point Portico at your folders. It adds posters, artwork, cast, seasons and episodes, so your own library feels like a streaming service. Your files stay exactly where they are.</p>
        <ul class="check-list">
          <li>Movies, TV, anime, music, audiobooks, live channels and recordings</li>
          <li>Matches are easy to fix when a title comes in wrong</li>
          <li>Nothing is renamed, moved or rewritten</li>
        </ul>
        <a class="text-link" href="/docs/media/">How to organize your media <span aria-hidden="true">→</span></a>
      </div>
      <BrowserFrame src="/media/portico-detail.png" alt="A Portico show page for Fargo with Play next episode, Watchlist and Favorite actions" address="web.getportico.tv" />
    </div>
  </section>

  <section class="section" aria-labelledby="household-title">
    <div class="section-ambient ambient-amber" aria-hidden="true"></div>
    <div class="container">
      <h2 id="household-title" class="display-2">One server.<br />Everyone gets their own.</h2>
      <div class="household-board" role="img" aria-label="Three people on one Portico server, each with their own Continue Watching row and their own library access.">
        {people.map((person) => (
          <div class="person-card">
            <div class="person-head">
              <span class="person-avatar" style={`--hue: ${person.hue}`}>{person.name[0]}</span>
              <div><strong>{person.name}</strong><small>{person.role}</small></div>
            </div>
            <span class="person-label">Continue Watching</span>
            {person.watching.map((item) => (
              <div class="person-item">
                <span>{item.title}</span>
                <i style={`--progress: ${item.progress}%`}></i>
              </div>
            ))}
            <span class="person-label">Libraries</span>
            <div class="person-libraries">
              {allLibraries.map((library) => (
                <span class:list={[{ 'is-off': !person.libraries.includes(library) }]}>{library}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="rule-columns">
        <article>
          <h3>Stop on one screen, finish on another.</h3>
          <p>Progress is saved on your server, so any screen you sign in on knows where you stopped.</p>
        </article>
        <article>
          <h3>Everyone has their own account.</h3>
          <p>Progress, Saved items, history, ratings and preferences belong to the person watching, not to the TV.</p>
        </article>
        <article>
          <h3>You decide who sees what.</h3>
          <p>The server owner chooses which libraries and actions each person can use, and can take access away at any time.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="screens-title">
    <div class="container">
      <div class="section-head">
        <h2 id="screens-title" class="display-2">Every screen<br />in the house.</h2>
        <p class="lede">One server and one account across the web, phones, tablets, TVs and streaming boxes. Each app is designed for its screen: remote-first on the TV, touch-first on the phone.</p>
      </div>
      <div class="platform-board">
        <div class="platform-group">
          <h3>Watch on</h3>
          <ul class="platform-grid">
            {watchPlatforms.map((platform) => (
              <li><PlatformIcon name={platform.icon} /><span>{platform.name}</span></li>
            ))}
          </ul>
        </div>
        <div class="platform-group">
          <h3>Run the server on</h3>
          <ul class="platform-grid platform-grid-server">
            {serverPlatforms.map((platform) => (
              <li><PlatformIcon name={platform.icon} /><span>{platform.name}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <a class="text-link" href="/download/">See every download <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section" aria-labelledby="yours-title">
    <div class="container yours">
      <h2 id="yours-title" class="display-2">Yours, from<br />end to end.</h2>
      <div class="yours-grid">
        <article>
          <h3>Your media stays home.</h3>
          <p>Streams go directly from your server to your screen. Portico Cloud never relays, caches or inspects them, and it never sees your titles, files or watch history.</p>
        </article>
        <article>
          <h3>Free and open source.</h3>
          <p>No subscription and no premium tier. Portico Server is published under the GPL-3.0, and it runs entirely on your own hardware.</p>
        </article>
        <article>
          <h3>It just plays.</h3>
          <p>Portico plays the original file whenever the device can handle it. When it can't, the server converts it on the fly for that screen.</p>
        </article>
        <article>
          <h3>Live TV and DVR.</h3>
          <p>Add your tuner or channel source and guide data, then watch live, schedule recordings and sort out conflicts on the same server.</p>
        </article>
      </div>
      <div class="connection-diagram" role="img" aria-label="Portico apps connect directly to your Portico Server. Portico Cloud only helps them find it.">
        <div class="node">
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="6" width="26" height="17" rx="2" /><path d="M11 28h10M16 23v5" /></svg>
          <strong>Your screens</strong><span>Web, phone, TV</span>
        </div>
        <div class="link">
          <span>Media, direct</span>
          <svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M0 6h200" /></svg>
        </div>
        <div class="node node-server">
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="5" y="5" width="22" height="9" rx="2" /><rect x="5" y="18" width="22" height="9" rx="2" /><path d="M9 9.5h2M9 22.5h2" /></svg>
          <strong>Your server</strong><span>Library, accounts, playback</span>
        </div>
        <div class="cloud-note">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M9 24h15a5 5 0 0 0 .6-10A8 8 0 0 0 9.2 13 5.5 5.5 0 0 0 9 24Z" /></svg>
          <span><strong>Portico Cloud</strong> helps your apps find and verify the server. It never carries media.</span>
        </div>
      </div>
      <a class="text-link" href="/docs/remote/how-portico-connects/">How Portico connects <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title" class="display-2">From download<br />to movie night.</h2>
      <ol class="step-cards">
        <li class="step-blue">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="6" rx="1.5" /><rect x="4" y="14" width="16" height="6" rx="1.5" /><path d="M7.5 7h1M7.5 17h1" /></svg>
          <span class="step-number">01</span>
          <h3>Install the server</h3>
          <p>Download Portico Server for Windows, macOS or Linux, or run it in Docker, on the computer that holds your media.</p>
        </li>
        <li class="step-teal">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /><path d="m10.5 10.5 4 2.5-4 2.5Z" /></svg>
          <span class="step-number">02</span>
          <h3>Add your folders</h3>
          <p>Create a library for each kind of media. Portico scans the files and fills in artwork and details.</p>
        </li>
        <li class="step-amber">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="15" height="11" rx="1.5" /><path d="M7 19h5M9.5 15v4" /><rect x="17" y="9" width="5" height="10" rx="1.2" /></svg>
          <span class="step-number">03</span>
          <h3>Invite people and press play</h3>
          <p>Add an account for each person, then sign in from the web or the Portico app on any screen.</p>
        </li>
      </ol>
      <a class="text-link" href="/docs/start/quick-start/">Read the quick start <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container faq">
      <h2 id="faq-title" class="display-2">Common<br />questions.</h2>
      <div class="faq-list">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}<span class="faq-icon" aria-hidden="true"></span></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="docs-title">
    <div class="container">
      <div class="section-head">
        <h2 id="docs-title" class="display-3">Documentation that goes all the way.</h2>
        <p class="lede">From the first install to backups, remote access and troubleshooting. Written for people who just want it working, with the detail there when you need it.</p>
      </div>
      <div class="docs-cards">
        <a href="/docs/start/"><strong>Start here</strong><span>Set up a server and add your first library.</span></a>
        <a href="/docs/media/"><strong>Organize media</strong><span>Name files, build libraries and fix matches.</span></a>
        <a href="/docs/remote/"><strong>Remote access</strong><span>Watch securely when you're away from home.</span></a>
        <a href="/docs/troubleshooting/"><strong>Troubleshooting</strong><span>Sort out connection, playback and library problems.</span></a>
      </div>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-ambient" aria-hidden="true"></div>
    <div class="container">
      <h2 id="cta-title" class="display-1">Bring your library home.</h2>
      <div class="hero-actions">
        <a class="button button-primary" href="/download/">Get Portico <span aria-hidden="true">↗</span></a>
        <a class="button button-ghost" href="/docs/">Read the docs</a>
      </div>
    </div>
  </section>

</BaseLayout>
